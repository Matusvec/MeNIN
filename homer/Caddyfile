{
	servers {
		# No HTTP/3: QUIC on UDP 443 stalls on venue and hotel Wi-Fi (headers arrive, the
		# body doesn't), and UFW only opens 443/tcp anyway. h1 and h2 over TCP only.
		protocols h1 h2
	}
}

# The agent service over HTTPS, for the caddy profile in docker-compose.yml.
# HOMER_HOST is the public name, for example 203.0.113.7.sslip.io. Caddy gets
# and renews its Let's Encrypt certificate by itself (ports 80 and 443 must be open).
{$HOMER_HOST} {
	reverse_proxy homer:8000 {
		# /judge streams the verdict as server-sent events: pass each event through at once.
		flush_interval -1
	}
}

# The website (SPEC "The website"): static files in /srv/menin-web on the droplet,
# published by scripts/web_deploy.sh. WEB_HOST is its own name, for example
# play.203.0.113.7.sslip.io, so it gets its own certificate.
{$WEB_HOST} {
	root * /srv/menin-web
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@page path / /index.html
	header @page Cache-Control "no-cache"  # a deploy shows at once; hashed assets can cache
	try_files {path} /index.html
	file_server
}
