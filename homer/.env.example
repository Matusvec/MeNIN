# Copy to homer/.env (gitignored) and fill in. Never commit real keys.

ANTHROPIC_API_KEY=

# The turn judge. Opus 5.5 can't turn thinking off; low effort keeps it short.
HOMER_JUDGE_MODEL=claude-opus-5-5
HOMER_JUDGE_EFFORT=low
# "fast" is Opus fast mode: 2x price (about $0.007 a turn), verdict p50 1.0 s instead of 2.0 s.
# Empty means standard speed. On a fast-mode rate limit the judge drops to standard by itself.
HOMER_JUDGE_SPEED=fast
# "off" turns thinking off where the model allows it (Haiku, Sonnet).
HOMER_JUDGE_THINKING=off
# Seconds before Homer is silent on Craft, Image and Answer.
HOMER_JUDGE_TIMEOUT=10
# Server-side refusal fallbacks (Opus, Sonnet 5.5).
HOMER_FALLBACKS=1
# Everything else Homer writes (poet names, round verdicts, the song, spar verses).
HOMER_MODEL=claude-opus-5-5
HOMER_EFFORT=low
HOMER_SPEED=fast
HOMER_TIMEOUT=15
# The emotion classifier behind the scene's colors, called every ~1.5 s while a poet speaks.
HOMER_EMOTION_MODEL=claude-haiku-5-5
# One real judge call at startup so the prompt is cached before the first turn.
HOMER_WARM=1

# Cartesia voice (docs/voice.md). The app gets short-lived tokens from POST /voice/token.
CARTESIA_API_KEY=
CARTESIA_VERSION=2026-08-14
HOMER_VOICE_TOKEN_TTL=300
HOMER_STT_MODEL=ink-2
HOMER_STT_ENCODING=pcm_s16le
HOMER_STT_SAMPLE_RATE=16000
HOMER_TTS_MODEL=sonic-3.6
# Homer's voice: a Cartesia voice id (Carl, picked Oct 24).
HOMER_VOICE_ID=ed82c17b-4704-4d34-be43-5d19065acdf1
# Socrates' voice, for the debate event.
SOCRATES_VOICE_ID=

# Abuse guard (homer/guard.py). The iOS app sends HOMER_APP_KEY as X-Homer-Key.
# Keep REQUIRED=0 until every build in use sends it, then set 1.
HOMER_APP_KEY=
HOMER_APP_KEY_REQUIRED=0
# Global caps on calls in any one hour; past a cap, the judge goes silent (never a canned verdict).
HOMER_MAX_CLAUDE_PER_HOUR=600
HOMER_MAX_CHEAP_PER_HOUR=4000
HOMER_MAX_VOICE_TOKENS_PER_HOUR=600

# SpacetimeDB (battle mode). See spacetime/CONTRACT.md.
STDB_URL=http://127.0.0.1:3000
STDB_DB=homer
STDB_TOKEN=
HOMER_SERVICE_KEY=

# Deploy (docker-compose.yml): the Cloudflare Tunnel token for api.<domain>.
CLOUDFLARE_TUNNEL_TOKEN=
